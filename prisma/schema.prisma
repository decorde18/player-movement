generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                 @id @default(autoincrement())
  name                  String              @db.VarChar(255)
  email                 String              @unique(map: "email") @db.VarChar(255)
  passwordHash          String?             @map("password_hash") @db.VarChar(255)
  password              String?             @db.VarChar(255)
  role                  users_role          @default(coach)
  assigned_team_id      Int?
  assigned_age_group_id Int?
  created_at            DateTime?           @default(now()) @db.Timestamp(0)
  resetToken            String?             @map("reset_token") @db.VarChar(255)
  resetTokenExpiry      DateTime?           @map("reset_token_expiry") @db.DateTime(0)
  club_id               Int?
  coach_notes           coach_notes[]
  clubs                 clubs?              @relation(fields: [club_id], references: [id], onUpdate: Restrict, map: "fk_user_club")
  season_teams          season_teams?       @relation(fields: [assigned_team_id], references: [id], onUpdate: Restrict, map: "fk_user_season_team")
  age_groups            age_groups?         @relation(fields: [assigned_age_group_id], references: [id], onUpdate: Restrict, map: "fk_user_age_group")
  user_age_groups       user_age_groups[]
  user_season_teams     user_season_teams[]

  @@index([club_id], map: "fk_user_club")
  @@index([assigned_team_id], map: "fk_user_season_team")
  @@index([assigned_age_group_id], map: "fk_user_age_group")
  @@map("users")
}

model age_groups {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(50)
  dob_start         DateTime            @db.Date
  dob_end           DateTime            @db.Date
  cutoff_type       String?             @default("seasonal") @db.VarChar(20)
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  season_age_groups season_age_groups[]
  users             User[]
  user_age_groups   user_age_groups[]
}

model club_seasons {
  club_id   Int
  season_id Int
  clubs     clubs   @relation(fields: [club_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "club_seasons_ibfk_1")
  seasons   seasons @relation(fields: [season_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "club_seasons_ibfk_2")

  @@id([club_id, season_id])
  @@index([season_id], map: "season_id")
}

model clubs {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  created_at     DateTime?        @default(now()) @db.Timestamp(0)
  club_seasons   club_seasons[]
  season_players season_players[]
  teams          teams[]
  users          User[]
}

model coach_notes {
  id            Int               @id @default(autoincrement())
  coach_id      Int
  session_id    Int?
  event_id      Int?
  invitation_id Int?
  player_id     Int
  note_text     String            @db.Text
  created_at    DateTime?         @default(now()) @db.Timestamp(0)
  users         User              @relation(fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "coach_notes_ibfk_1")
  sessions      sessions?         @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "coach_notes_ibfk_2")
  events        events?           @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "coach_notes_ibfk_3")
  players       players           @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "coach_notes_ibfk_4")
  invitations   team_invitations? @relation(fields: [invitation_id], references: [id], onDelete: Cascade)

  @@index([coach_id], map: "coach_id")
  @@index([event_id], map: "event_id")
  @@index([player_id], map: "player_id")
  @@index([session_id], map: "session_id")
  @@index([invitation_id], map: "invitation_id")
}

model event_divisions {
  event_id            Int
  season_age_group_id Int
  events              events            @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_divisions_ibfk_1")
  season_age_groups   season_age_groups @relation(fields: [season_age_group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_divisions_ibfk_2")

  @@id([event_id, season_age_group_id])
  @@index([season_age_group_id], map: "season_age_group_id")
}

model events {
  id                    Int                     @id @default(autoincrement())
  season_id             Int
  name                  String                  @db.VarChar(255)
  event_type            events_event_type
  created_at            DateTime?               @default(now()) @db.Timestamp(0)
  is_finalized          Boolean?                @default(false)
  finalized_by          String?                 @db.VarChar(255)
  finalized_at          DateTime?               @db.Timestamp(0)
  rating_direction      String?                 @default("high_is_best") @db.VarChar(50)
  tiers                 String?                 @db.Text
  coach_notes           coach_notes[]
  event_divisions       event_divisions[]
  event_players         event_players[]
  event_player_rankings event_player_rankings[]
  seasons               seasons                 @relation(fields: [season_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "events_ibfk_1")
  sessions              sessions[]

  @@index([season_id], map: "season_id")
}

model players {
  id                    Int                     @id @default(autoincrement())
  first_name            String                  @db.VarChar(100)
  last_name             String                  @db.VarChar(100)
  date_of_birth         DateTime?               @db.Date
  gender                String?                 @db.VarChar(20)
  created_at            DateTime?               @default(now()) @db.Timestamp(0)
  coach_notes           coach_notes[]
  event_players         event_players[]
  season_players        season_players[]
  session_players       session_players[]
  event_player_rankings event_player_rankings[]
}

model season_age_groups {
  id              Int               @id @default(autoincrement())
  season_id       Int
  age_group_id    Int
  name            String            @db.VarChar(20)
  gender          String            @db.VarChar(20)
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  event_divisions event_divisions[]
  seasons         seasons           @relation(fields: [season_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "season_age_groups_ibfk_1")
  age_groups      age_groups        @relation(fields: [age_group_id], references: [id], onUpdate: Restrict, map: "season_age_groups_ibfk_2")
  season_players  season_players[]
  season_teams    season_teams[]
  sessions        sessions[]

  @@unique([season_id, age_group_id, gender], map: "season_id")
  @@index([age_group_id], map: "age_group_id")
}

model season_players {
  id                  Int               @id @default(autoincrement())
  player_id           Int
  season_age_group_id Int
  club_id             Int?
  tryout_number       String?           @db.VarChar(50)
  position            String?           @db.VarChar(50)
  rating              Int?              @default(0)
  created_at          DateTime?         @default(now()) @db.Timestamp(0)
  player_status       String?           @default("none") @db.VarChar(50)
  season_team_id      Int?
  uniform_number      String?           @db.VarChar(20)
  players             players           @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "season_players_ibfk_1")
  season_age_groups   season_age_groups @relation(fields: [season_age_group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "season_players_ibfk_2")
  season_teams        season_teams?     @relation(fields: [season_team_id], references: [id], onUpdate: Restrict, map: "season_players_ibfk_3")
  clubs               clubs?            @relation(fields: [club_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "season_players_ibfk_4")
  team_invitations    team_invitations[]

  @@unique([player_id, season_age_group_id, club_id], map: "player_season_club")
  @@index([player_id], map: "player_id")
  @@index([season_age_group_id], map: "season_age_group_id")
  @@index([season_team_id], map: "season_team_id")
  @@index([club_id], map: "club_id")
}

model seasons {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(255)
  start_date        DateTime?           @db.Date
  end_date          DateTime?           @db.Date
  cutoff_type       String?             @default("seasonal") @db.VarChar(20)
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  club_seasons      club_seasons[]
  events            events[]
  season_age_groups season_age_groups[]
}

model session_fields {
  id              Int                            @id @default(autoincrement())
  session_id      Int
  name            String                         @db.VarChar(255)
  sort_by         String?                        @default("name") @db.VarChar(50)
  sort_direction  session_fields_sort_direction? @default(asc)
  filter_by       String?                        @default("all") @db.VarChar(50)
  created_at      DateTime?                      @default(now()) @db.Timestamp(0)
  rating_filter   String?                        @default("all") @db.VarChar(50)
  sessions        sessions                       @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "session_fields_ibfk_1")
  session_players session_players[]

  @@index([session_id], map: "session_id")
}

model session_players {
  id                     Int                                @id @default(autoincrement())
  session_id             Int
  player_id              Int
  season_team_id         Int?
  attendance_status      session_players_attendance_status? @default(present)
  created_at             DateTime?                          @default(now()) @db.Timestamp(0)
  field_id               Int?
  rank                   Int?                               @default(0)
  rating                 Float?                             @default(0)
  session_fields         session_fields?                    @relation(fields: [field_id], references: [id], onUpdate: Restrict, map: "fk_session_field")
  sessions               sessions                           @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "session_players_ibfk_1")
  players                players                            @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "session_players_ibfk_2")
  season_teams           season_teams?                      @relation(fields: [season_team_id], references: [id], onUpdate: Restrict, map: "fk_session_players_season_team")
  session_player_ratings session_player_ratings[]

  @@unique([session_id, player_id], map: "session_id")
  @@index([field_id], map: "fk_session_field")
  @@index([player_id], map: "player_id")
  @@index([season_team_id], map: "season_team_id")
}

model session_player_ratings {
  id                Int             @id @default(autoincrement())
  session_player_id Int
  coach_id          String          @db.VarChar(255)
  coach_name        String          @db.VarChar(255)
  rating            Float
  created_at        DateTime?       @default(now()) @db.Timestamp(0)
  updated_at        DateTime?       @default(now()) @db.Timestamp(0)
  session_players   session_players @relation(fields: [session_player_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "session_player_ratings_ibfk_1")

  @@unique([session_player_id, coach_id], map: "session_player_coach")
  @@index([session_player_id], map: "session_player_id")
}

model sessions {
  id                  Int                @id @default(autoincrement())
  event_id            Int
  season_age_group_id Int?
  name                String             @db.VarChar(255)
  session_date        DateTime           @db.Date
  created_at          DateTime?          @default(now()) @db.Timestamp(0)
  coach_notes         coach_notes[]
  session_fields      session_fields[]
  session_players     session_players[]
  events              events             @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "sessions_ibfk_1")
  season_age_groups   season_age_groups? @relation(fields: [season_age_group_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "sessions_ibfk_2")

  @@index([event_id], map: "event_id")
  @@index([season_age_group_id], map: "season_age_group_id")
}

model teams {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  sort_by      String?        @default("name") @db.VarChar(50)
  filter_by    String?        @default("all") @db.VarChar(50)
  created_at   DateTime?      @default(now()) @db.Timestamp(0)
  club_id      Int?
  clubs        clubs?         @relation(fields: [club_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_team_club")
  season_teams season_teams[]

  @@index([club_id], map: "fk_team_club")
}

model season_teams {
  id                  Int                 @id @default(autoincrement())
  team_id             Int
  season_age_group_id Int
  created_at          DateTime?           @default(now()) @db.Timestamp(0)
  sort_order          Int?                @default(0)
  teams               teams               @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "season_teams_ibfk_1")
  season_age_groups   season_age_groups   @relation(fields: [season_age_group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "season_teams_ibfk_2")
  season_players      season_players[]
  session_players     session_players[]
  users               User[]
  team_invitations    team_invitations[]
  user_season_teams   user_season_teams[]

  @@unique([team_id, season_age_group_id], map: "team_id")
  @@index([season_age_group_id], map: "season_age_group_id")
}

model team_invitations {
  id               Int            @id @default(autoincrement())
  season_player_id Int
  season_team_id   Int
  status           String         @default("pending") @db.VarChar(50)
  sent_at          DateTime?      @default(now()) @db.Timestamp(0)
  responded_at     DateTime?      @db.Timestamp(0)
  notes            String?        @db.VarChar(255)
  created_at       DateTime?      @default(now()) @db.Timestamp(0)
  updated_at       DateTime?      @default(now()) @db.Timestamp(0)

  season_players   season_players @relation(fields: [season_player_id], references: [id], onDelete: Cascade)
  season_teams     season_teams   @relation(fields: [season_team_id], references: [id], onDelete: Cascade)
  coach_notes      coach_notes[]

  @@index([season_player_id])
  @@index([season_team_id])
}

model event_players {
  id                  Int                                @id @default(autoincrement())
  event_id            Int
  player_id           Int
  availability_status event_players_availability_status? @default(available)
  created_at          DateTime?                          @default(now()) @db.Timestamp(0)
  events              events                             @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_event_players_event")
  players             players                            @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_event_players_player")

  @@unique([event_id, player_id], map: "event_player_unique")
  @@index([player_id], map: "fk_event_players_player")
}

enum events_event_type {
  tryout
  ranking
}

enum event_players_availability_status {
  available
  unavailable
}

enum session_players_attendance_status {
  present
  absent
  excused
}

enum session_fields_sort_direction {
  asc
  desc
}

enum users_role {
  system_admin
  club_admin
  age_group_admin
  coach
}

model event_player_rankings {
  id         Int       @id @default(autoincrement())
  event_id   Int
  player_id  Int
  coach_id   String    @db.VarChar(255)
  rank       Int
  tier       String?   @db.VarChar(50)
  rating     Float?    @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)

  events     events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_epr_event")
  players    players   @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_epr_player")

  @@unique([event_id, player_id, coach_id], map: "event_player_coach_rank")
  @@index([player_id], map: "player_id")
  @@index([event_id], map: "event_id")
}

model user_age_groups {
  user_id      Int
  age_group_id Int
  users        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  age_groups   age_groups @relation(fields: [age_group_id], references: [id], onDelete: Cascade)

  @@id([user_id, age_group_id])
  @@index([age_group_id])
}

model user_season_teams {
  user_id        Int
  season_team_id Int
  users          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  season_teams   season_teams @relation(fields: [season_team_id], references: [id], onDelete: Cascade)

  @@id([user_id, season_team_id])
  @@index([season_team_id])
}
